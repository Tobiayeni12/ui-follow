# =============================================================================
# TikTok 3D Follower Counter — environment configuration
# Copy this file to ".env" and fill in the values. Never commit ".env".
# =============================================================================

# --- Server ------------------------------------------------------------------
# Port the Express server listens on.
PORT=3000

# Public base URL of this deployment, e.g. https://my-domain.onrender.com
# Used to build the TikTok redirect URI helper text in the dashboard and to
# generate correct absolute links. No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# Set to "production" when deployed. Enables secure cookies, trust proxy, etc.
NODE_ENV=development

# --- Demo mode -----------------------------------------------------------------
# When true, the server NEVER talks to TikTok. Instead it runs an in-memory
# fake follower counter you can drive from the dashboard (+1 / +5 / +10 / reset).
# This lets you finish the entire 3D visual/animation system before your
# TikTok Developer app is approved. Set to "false" once you're ready to go live.
DEMO_MODE=true

# Starting follower count used only in DEMO_MODE.
DEMO_START_COUNT=1247

# --- Follower goal -------------------------------------------------------------
# Used for the "ROAD TO 2K" progress indicator. Any whole number.
FOLLOWER_GOAL=2000

# --- TikTok Developer App credentials -------------------------------------------
# Obtained from https://developers.tiktok.com/apps after creating an app.
# NEVER expose these in frontend code. They are read only on the server.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must exactly match a "Redirect URI" configured in your TikTok app, e.g.
# https://my-domain.onrender.com/auth/tiktok/callback
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# --- Follower polling ------------------------------------------------------------
# How often (in milliseconds) the server checks TikTok's follower_count.
# Minimum enforced floor is 30000 (30s) to respect TikTok API rate limits.
# 60000 = check once per minute (recommended default).
FOLLOWER_POLL_INTERVAL=60000

# --- Dashboard security ----------------------------------------------------------
# Password required to log into /dashboard. If left blank, a random password
# is generated at server startup and printed once to the server logs.
DASHBOARD_PASSWORD=

# Secret used to sign the dashboard session cookie. Use a long random string
# in production, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Storage --------------------------------------------------------------------
# Optional. If set, tokens/settings/follower state are persisted to Postgres
# instead of a local JSON file (recommended for production deployments on
# platforms with ephemeral filesystems). Example:
# postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Safety toggle ----------------------------------------------------------------
# When false (default), dashboard "test" buttons only affect the dashboard's
# own preview window, never the public /overlay, once you are connected to a
# real TikTok account (DEMO_MODE=false). Flip to true only if you explicitly
# want test buttons to also push fake numbers to the live overlay.
ALLOW_TEST_ON_LIVE_OVERLAY=false
